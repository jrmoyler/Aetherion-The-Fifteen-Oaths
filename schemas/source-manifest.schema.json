{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aetherion:schema:source-manifest:1",
  "type": "object",
  "required": [
    "format",
    "sourceCommit",
    "sourceRepository",
    "sourceReadOnly",
    "fileCount",
    "totalBytes",
    "files"
  ],
  "properties": {
    "format": {
      "const": "aetherion-source-manifest@1"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sourceReadOnly": {
      "const": true
    },
    "fileCount": {
      "const": 1896
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 1
    },
    "files": {
      "type": "array",
      "minItems": 1896,
      "maxItems": 1896,
      "items": {
        "type": "object",
        "required": [
          "sourcePath",
          "destinationPath",
          "bytes",
          "sha256",
          "category",
          "mode"
        ],
        "properties": {
          "sourcePath": {
            "type": "string",
            "minLength": 1
          },
          "destinationPath": {
            "type": "string",
            "pattern": "^runtime/ability-matrix/"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "category": {
            "enum": [
              "asset",
              "source-or-support"
            ]
          },
          "mode": {
            "enum": [
              "100644",
              "100755"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}

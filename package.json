{
  "name": "aetherion-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aetherion canon and source-preserving Ability Matrix integration",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:source": "npm --prefix runtime/ability-matrix test",
    "test:all": "npm test && npm run test:source && npm run test:world",
    "validate:migration": "node tools/validate-migration.mjs",
    "dev:abilities": "node tools/run-abilities.mjs dev",
    "build:abilities": "node tools/run-abilities.mjs build",
    "preview:abilities": "node tools/run-abilities.mjs preview",
    "test:canon": "python3 AETHERION_CANON/19_VALIDATION/validate_canon.py --repo .",
    "test:canon-fixtures": "python3 -m unittest discover -s AETHERION_CANON/19_VALIDATION -p test_validator.py",
    "test:world": "npm --prefix runtime/world-kernel test",
    "dev:daybreak": "node tools/run-daybreak.mjs dev",
    "build:daybreak": "node tools/run-daybreak.mjs build",
    "preview:daybreak": "node tools/run-daybreak.mjs preview",
    "test:daybreak": "node --test app/daybreak/*.test.mjs",
    "mmo:install": "npm ci --prefix game && npm ci --prefix server",
    "mmo:dev": "npm --prefix game run dev",
    "mmo:build": "npm --prefix game run build",
    "mmo:server": "npm --prefix server start",
    "mmo:start": "npm run mmo:build && npm run mmo:server",
    "mmo:test": "npm --prefix server test",
    "mmo:abilities": "node tools/generate-mmo-abilities.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

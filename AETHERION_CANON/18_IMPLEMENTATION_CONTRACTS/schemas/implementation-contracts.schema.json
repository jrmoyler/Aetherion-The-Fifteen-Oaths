{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aetherion:schema:implementation-contracts:1.0.0",
  "title": "Proposed Aetherion implementation contracts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canon_status",
    "source_ids",
    "records",
    "contract_model"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "canon_status": {
      "const": "PROPOSED"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "canon_status",
          "source_ids",
          "title",
          "interface_status",
          "versioning",
          "persistence_recovery",
          "performance",
          "accessibility_localization",
          "inputs",
          "outputs",
          "state",
          "transitions",
          "authority",
          "dependencies",
          "risks",
          "acceptance_tests",
          "observability"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^contract-[a-z0-9-]+$"
          },
          "canon_status": {
            "const": "PROPOSED"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "interface_status": {
            "type": "string",
            "minLength": 1
          },
          "versioning": {
            "type": "string",
            "minLength": 1
          },
          "persistence_recovery": {
            "type": "string",
            "minLength": 1
          },
          "performance": {
            "type": "string",
            "minLength": 1
          },
          "accessibility_localization": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type",
                "required",
                "constraints"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "string",
                    "integer",
                    "array",
                    "object",
                    "boolean",
                    "enum"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "constraints": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type",
                "required",
                "constraints"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "string",
                    "integer",
                    "array",
                    "object",
                    "boolean",
                    "enum"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "constraints": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "state": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "states",
              "storage",
              "identity"
            ],
            "properties": {
              "states": {
                "type": "array",
                "uniqueItems": true,
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "storage": {
                "type": "string"
              },
              "identity": {
                "type": "string"
              }
            }
          },
          "transitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "event",
                "to",
                "guard",
                "atomic_changes"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "event": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "guard": {
                  "type": "string",
                  "minLength": 1
                },
                "atomic_changes": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "writer",
              "client_permission",
              "scope"
            ],
            "properties": {
              "writer": {
                "type": "string"
              },
              "client_permission": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              }
            }
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^contract-"
            }
          },
          "risks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "acceptance_tests": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "given",
                "when",
                "then",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "given": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "then": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "const": "SPECIFIED_NOT_EXECUTED"
                }
              }
            }
          },
          "observability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record",
              "privacy"
            ],
            "properties": {
              "record": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "privacy": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "contract_model": {
      "type": "string"
    }
  }
}

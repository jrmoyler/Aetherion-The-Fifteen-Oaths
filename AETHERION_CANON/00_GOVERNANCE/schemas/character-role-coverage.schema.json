{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canon_status",
    "records",
    "schema_version",
    "source_ids"
  ],
  "properties": {
    "canon_status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "LOCKED",
        "RECOVERED",
        "PROPOSED",
        "UNRESOLVED",
        "DEPRECATED"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authored_scope",
          "canon_status",
          "character_ids",
          "coverage_status",
          "id",
          "production_gap",
          "role",
          "source_ids"
        ],
        "properties": {
          "authored_scope": {
            "type": "string",
            "minLength": 1
          },
          "canon_status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "LOCKED",
              "RECOVERED",
              "PROPOSED",
              "UNRESOLVED",
              "DEPRECATED"
            ]
          },
          "character_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^character-(?:[0-9]{2}-(?:leader|civilian|handler|wayfarer)|player|archivist)$"
            },
            "uniqueItems": true
          },
          "coverage_status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "AUTHORED"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "role-antagonists",
              "role-civilians",
              "role-creature-handlers",
              "role-leaders",
              "role-main-cast",
              "role-mentors",
              "role-merchants-craftspeople",
              "role-quest-givers",
              "role-rivals",
              "role-wandering-unbound"
            ]
          },
          "production_gap": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "Civic professionals",
              "Conditional antagonists",
              "Creature handlers",
              "Main cast",
              "Mentors",
              "Merchants and craftspeople",
              "Quest givers",
              "Realm leaders",
              "Rivals",
              "Wandering Unbound-related roles"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(SRC-[A-Za-z0-9-]+|REF-[0-9]{3})$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "const": "1.0.0"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(SRC-[A-Za-z0-9-]+|REF-[0-9]{3})$"
      },
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aetherion:character-role-coverage:1.0.0",
  "title": "Aetherion Character Role Coverage",
  "description": "Strict field-level schema for the authored preproduction registry. Stable record IDs and all object fields are explicit. Schema validity does not confer canon approval, implementation or semantic truth."
}

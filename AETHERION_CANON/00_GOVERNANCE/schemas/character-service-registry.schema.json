{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canon_status",
    "records",
    "schema_version",
    "source_ids"
  ],
  "properties": {
    "canon_status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "LOCKED",
        "RECOVERED",
        "PROPOSED",
        "UNRESOLVED",
        "DEPRECATED"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "availability_flag",
          "canon_status",
          "character_id",
          "essential_access",
          "id",
          "implementation_status",
          "interaction",
          "limits",
          "name",
          "poi_ids",
          "quest_ids",
          "region_ids",
          "source_ids"
        ],
        "properties": {
          "availability_flag": {
            "type": "string",
            "minLength": 1
          },
          "canon_status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "LOCKED",
              "RECOVERED",
              "PROPOSED",
              "UNRESOLVED",
              "DEPRECATED"
            ]
          },
          "character_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^character-(?:[0-9]{2}-(?:leader|civilian|handler|wayfarer)|player|archivist)$"
          },
          "essential_access": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "service-hart-care",
              "service-independent-routing",
              "service-manual-override-training",
              "service-road-records"
            ]
          },
          "implementation_status": {
            "type": "string",
            "minLength": 1
          },
          "interaction": {
            "type": "string",
            "minLength": 1
          },
          "limits": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "poi_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^poi-[a-z0-9-]+$"
            },
            "uniqueItems": true
          },
          "quest_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^quest-[a-z0-9-]+$"
            },
            "uniqueItems": true
          },
          "region_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "region-01",
                "region-02",
                "region-03",
                "region-04",
                "region-05",
                "region-06",
                "region-07",
                "region-08",
                "region-09",
                "region-10",
                "region-11",
                "region-12",
                "region-13",
                "region-14",
                "region-15"
              ]
            },
            "uniqueItems": true
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(SRC-[A-Za-z0-9-]+|REF-[0-9]{3})$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "const": "1.0.0"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(SRC-[A-Za-z0-9-]+|REF-[0-9]{3})$"
      },
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aetherion:character-service-registry:1.0.0",
  "title": "Aetherion Character Service Registry",
  "description": "Strict field-level schema for the authored preproduction registry. Stable record IDs and all object fields are explicit. Schema validity does not confer canon approval, implementation or semantic truth."
}

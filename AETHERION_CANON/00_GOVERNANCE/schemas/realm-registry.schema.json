            "type": "string",
            "minLength": 1
          },
          "economy": {
            "type": "string",
            "minLength": 1
          },
          "elevation_band": {
            "type": "string",
            "minLength": 1
          },
          "event_location_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^poi-[a-z0-9-]+$"
            },
            "uniqueItems": true
          },
          "exports": {
            "type": "array",

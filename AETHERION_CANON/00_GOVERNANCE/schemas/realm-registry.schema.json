            "type": "string",
            "minLength": 1,
            "enum": [
              "LOCKED",
              "RECOVERED",
              "PROPOSED",
              "UNRESOLVED",
              "DEPRECATED"
            ]
          },
          "capital_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^poi-[a-z0-9-]+$"
          },
          "civilian_character_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^character-(?:[0-9]{2}-(?:leader|civilian|handler|wayfarer)|player|archivist)$"
            },
            "uniqueItems": true
          },
          "civilian_culture": {
            "type": "string",
            "minLength": 1
          },
          "climate": {

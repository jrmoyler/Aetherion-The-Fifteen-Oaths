          "neighbor_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "region-01",
                "region-02",
                "region-03",
                "region-04",
                "region-05",
                "region-06",
                "region-07",
                "region-08",
                "region-09",
                "region-10",
                "region-11",

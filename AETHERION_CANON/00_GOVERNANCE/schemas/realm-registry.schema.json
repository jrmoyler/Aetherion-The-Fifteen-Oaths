{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canon_status",
    "records",
    "schema_version",
    "source_ids"
  ],
  "properties": {
    "canon_status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "LOCKED",
        "RECOVERED",
        "PROPOSED",
        "UNRESOLVED",
        "DEPRECATED"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "architecture",
          "canon_status",
          "capital_id",
          "civilian_character_ids",
          "civilian_culture",
          "climate",
          "dossier_path",
          "drainage_basin_ids",
          "dungeon_ids",
          "ecology",
          "economy",
          "elevation_band",
          "event_location_ids",
          "exports",
          "faction_id",
          "first_oath_independence",
          "hazards",
          "housing",
          "id",
          "imports",
          "leader_id",
          "name",
          "neighbor_ids",
          "oath_id",
          "obligation",
          "political_structure",
          "regional_quest_id",
          "relative_position",
          "settlement_ids",
          "source_ids",
          "terrain_authority",
          "transition"

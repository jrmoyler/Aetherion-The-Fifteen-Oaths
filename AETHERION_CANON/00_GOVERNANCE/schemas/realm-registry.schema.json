            "type": "string",
            "minLength": 1
          },
          "transition": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 15,
      "maxItems": 15
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "const": "1.0.0"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(SRC-[A-Za-z0-9-]+|REF-[0-9]{3})$"
      },

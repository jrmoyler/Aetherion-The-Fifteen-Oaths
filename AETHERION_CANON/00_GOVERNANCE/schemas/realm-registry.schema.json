          "settlement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^poi-[a-z0-9-]+$"
            },
            "uniqueItems": true
          },
          "source_ids": {
            "type": "array",

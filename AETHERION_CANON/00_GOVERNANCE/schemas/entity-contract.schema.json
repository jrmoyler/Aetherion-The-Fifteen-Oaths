{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canon_status",
    "records",
    "schema_version",
    "scope_note",
    "source_ids"
  ],
  "properties": {
    "canon_status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "LOCKED",
        "RECOVERED",
        "PROPOSED",
        "UNRESOLVED",
        "DEPRECATED"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "boss",
          "canon_status",
          "capital",
          "capital_id",
          "civilian",
          "civilian_id",
          "creature",
          "dungeon",
          "dungeon_id",
          "element",
          "event_id",
          "faction_id",
          "id",
          "leader",
          "leader_id",
          "locked_fields",
          "mount",
          "neighbor_ids",
          "oath_id",
          "oath_name",
          "proposed_fields",
          "region_id",
          "regional_quest_id",
          "settlement",
          "settlement_id",
          "source_ids"
        ],
        "properties": {
          "boss": {
            "type": "string",
            "minLength": 1
          },
          "canon_status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "LOCKED",
              "RECOVERED",
              "PROPOSED",
              "UNRESOLVED",
              "DEPRECATED"
            ]
          },
          "capital": {
            "type": "string",
            "minLength": 1
          },
          "capital_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^poi-[a-z0-9-]+$"
          },
          "civilian": {
            "type": "string",
            "minLength": 1
          },
          "civilian_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^character-(?:[0-9]{2}-(?:leader|civilian|handler|wayfarer)|player|archivist)$"
          },
          "creature": {
            "type": "string",
            "minLength": 1
          },
          "dungeon": {
            "type": "string",
            "minLength": 1
          },
          "dungeon_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^poi-[a-z0-9-]+$"
          },
          "element": {
            "type": "string",
            "minLength": 1
          },
          "event_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^poi-[a-z0-9-]+$"
          },
          "faction_id": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "faction-01",
              "faction-02",
              "faction-03",
              "faction-04",
              "faction-05",
              "faction-06",
              "faction-07",
              "faction-08",
              "faction-09",
              "faction-10",
              "faction-11",
              "faction-12",
              "faction-13",
              "faction-14",
              "faction-15"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "oath-01",
              "oath-02",
              "oath-03",
              "oath-04",
              "oath-05",
              "oath-06",
              "oath-07",
              "oath-08",
              "oath-09",
              "oath-10",
              "oath-11",
              "oath-12",
              "oath-13",
              "oath-14",
              "oath-15"
            ]
          },
          "leader": {
            "type": "string",
            "minLength": 1
          },
          "leader_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^character-(?:[0-9]{2}-(?:leader|civilian|handler|wayfarer)|player|archivist)$"
          },
          "locked_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "mount": {
            "type": "string",
            "minLength": 1
          },
          "neighbor_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "region-01",
                "region-02",
                "region-03",
                "region-04",
                "region-05",
                "region-06",
                "region-07",
                "region-08",
                "region-09",
                "region-10",
                "region-11",
                "region-12",
                "region-13",
                "region-14",
                "region-15"
              ]
            },
            "uniqueItems": true
          },
          "oath_id": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "oath-01",
              "oath-02",
              "oath-03",
              "oath-04",
              "oath-05",
              "oath-06",
              "oath-07",
              "oath-08",
              "oath-09",
              "oath-10",
              "oath-11",
              "oath-12",
              "oath-13",
              "oath-14",
              "oath-15"
            ]
          },
          "oath_name": {
            "type": "string",
            "minLength": 1
          },
          "proposed_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "region_id": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "region-01",
              "region-02",
              "region-03",
              "region-04",
              "region-05",
              "region-06",
              "region-07",
              "region-08",
              "region-09",
              "region-10",
              "region-11",
              "region-12",
              "region-13",
              "region-14",
              "region-15"
            ]
          },
          "regional_quest_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^quest-[a-z0-9-]+$"
          },
          "settlement": {
            "type": "string",
            "minLength": 1
          },
          "settlement_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^poi-[a-z0-9-]+$"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(SRC-[A-Za-z0-9-]+|REF-[0-9]{3})$"
            },
            "uniqueItems": true
          }
        }
      },
      "minItems": 15,
      "maxItems": 15
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "const": "1.0.0"
    },
    "scope_note": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(SRC-[A-Za-z0-9-]+|REF-[0-9]{3})$"
      },
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aetherion:entity-contract:1.0.0",
  "title": "Aetherion Entity Contract",
  "description": "Strict field-level schema for the authored preproduction registry. Stable record IDs and all object fields are explicit. Schema validity does not confer canon approval, implementation or semantic truth."
}

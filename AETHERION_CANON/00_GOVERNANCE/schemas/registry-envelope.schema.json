{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aetherion registry envelope",
  "type": "object",
  "required": [
    "schema_version",
    "canon_status",
    "source_ids"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "canon_status": {
      "type": "string",
      "enum": [
        "LOCKED",
        "RECOVERED",
        "PROPOSED",
        "UNRESOLVED",
        "DEPRECATED"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": true,
  "description": "Envelope schema only. Domain registries also require their specific schemas and semantic validation; this alone is not a completeness check."
}

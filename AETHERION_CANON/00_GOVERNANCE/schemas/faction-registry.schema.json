{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canon_status",
    "records",
    "schema_version",
    "source_ids"
  ],
  "properties": {
    "canon_status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "LOCKED",
        "RECOVERED",
        "PROPOSED",
        "UNRESOLVED",
        "DEPRECATED"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alliances",
          "branch_outcomes",
          "canon_status",
          "central_contradiction",
          "civic_counterpoint_id",
          "civilian_obligation",
          "economic_role",
          "id",
          "internal_variation",
          "leadership_id",
          "locked_identity_fields",
          "military_doctrine",
          "name",
          "oath_id",
          "political_structure",
          "public_benefit",
          "region_id",
          "regional_quest_id",
          "relationship_policy",
          "rivalries",
          "source_ids",
          "worldview"
        ],
        "properties": {
          "alliances": {
            "type": "string",
            "minLength": 1
          },
          "branch_outcomes": {
            "type": "string",
            "minLength": 1
          },
          "canon_status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "LOCKED",
              "RECOVERED",
              "PROPOSED",
              "UNRESOLVED",
              "DEPRECATED"
            ]
          },
          "central_contradiction": {
            "type": "string",
            "minLength": 1
          },
          "civic_counterpoint_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^character-(?:[0-9]{2}-(?:leader|civilian|handler|wayfarer)|player|archivist)$"
          },
          "civilian_obligation": {
            "type": "string",
            "minLength": 1
          },
          "economic_role": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "faction-01",
              "faction-02",
              "faction-03",
              "faction-04",
              "faction-05",
              "faction-06",
              "faction-07",
              "faction-08",
              "faction-09",
              "faction-10",
              "faction-11",
              "faction-12",
              "faction-13",
              "faction-14",
              "faction-15"
            ]
          },
          "internal_variation": {
            "type": "string",
            "minLength": 1
          },
          "leadership_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^character-(?:[0-9]{2}-(?:leader|civilian|handler|wayfarer)|player|archivist)$"
          },
          "locked_identity_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "military_doctrine": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "oath_id": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "oath-01",
              "oath-02",
              "oath-03",
              "oath-04",
              "oath-05",
              "oath-06",
              "oath-07",
              "oath-08",
              "oath-09",
              "oath-10",
              "oath-11",
              "oath-12",
              "oath-13",
              "oath-14",
              "oath-15"
            ]
          },
          "political_structure": {
            "type": "string",
            "minLength": 1
          },
          "public_benefit": {
            "type": "string",
            "minLength": 1
          },
          "region_id": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "region-01",
              "region-02",
              "region-03",
              "region-04",
              "region-05",
              "region-06",
              "region-07",
              "region-08",
              "region-09",
              "region-10",
              "region-11",
              "region-12",
              "region-13",
              "region-14",
              "region-15"
            ]
          },
          "regional_quest_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^quest-[a-z0-9-]+$"
          },
          "relationship_policy": {
            "type": "string",
            "minLength": 1
          },
          "rivalries": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(SRC-[A-Za-z0-9-]+|REF-[0-9]{3})$"
            },
            "uniqueItems": true
          },
          "worldview": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 15,
      "maxItems": 15
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "const": "1.0.0"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(SRC-[A-Za-z0-9-]+|REF-[0-9]{3})$"
      },
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aetherion:faction-registry:1.0.0",
  "title": "Aetherion Faction Registry",
  "description": "Strict field-level schema for the authored preproduction registry. Stable record IDs and all object fields are explicit. Schema validity does not confer canon approval, implementation or semantic truth."
}

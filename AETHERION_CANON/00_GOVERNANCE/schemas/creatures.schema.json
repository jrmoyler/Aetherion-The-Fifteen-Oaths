{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.invalid/schemas/creatures.schema.json",
  "title": "creatures",
  "description": "Field-level documentation contract. Passing schema does not establish design approval or runtime behavior.",
  "type": "object",
  "required": [
    "schema_version",
    "canon_status",
    "source_ids",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "canon_status": {
      "enum": [
        "LOCKED",
        "RECOVERED",
        "PROPOSED",
        "UNRESOLVED",
        "DEPRECATED"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "canon_status",
          "source_ids",
          "name",
          "oath_id",
          "region_id",
          "taxonomy",
          "production_status",
          "approval",
          "ecology",
          "anatomy",
          "locomotion",
          "behavior",
          "abilities",
          "encounter",
          "traversal",
          "animation_requirements",
          "sound_requirements",
          "visual_signature",
          "materials",
          "references",
          "model_construction",
          "complexity",
          "dependencies",
          "validation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "canon_status": {
            "enum": [
              "LOCKED",
              "RECOVERED",
              "PROPOSED",
              "UNRESOLVED",
              "DEPRECATED"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "oath_id": {
            "type": "string",
            "pattern": "^oath-(0[1-9]|1[0-5])$"
          },
          "region_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "taxonomy": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "production_status": {
            "type": "string",
            "minLength": 1
          },
          "approval": {
            "type": "object"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

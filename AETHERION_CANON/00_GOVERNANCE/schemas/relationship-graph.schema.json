    "schema_version": {
      "type": "string",
      "minLength": 1,
      "const": "1.0.0"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(SRC-[A-Za-z0-9-]+|REF-[0-9]{3})$"
      },
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aetherion:relationship-graph:1.0.0",
  "title": "Aetherion Relationship Graph",
  "description": "Strict field-level schema for the authored preproduction registry. Stable record IDs and all object fields are explicit. Schema validity does not confer canon approval, implementation or semantic truth."
}

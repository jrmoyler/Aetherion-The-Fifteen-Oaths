          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "accountability and refuge",
              "care and consent",
              "care and delivery obligation",
              "care and protected-route mediation",
              "civic accountability",
              "custody and privacy",
              "exit and inherited claims",
              "history and protected routes",
              "history and provenance",
              "measurement and causality",
              "medicine and ecology",
              "memory and representation",
              "navigation and model dispute",
              "optional reciprocal sponsorship",
              "performance and consent",
              "practical mentorship with independent graduation",
              "productive land dispute",
              "recurring professional rivalry",
              "retention dispute",
              "shared watershed dispute",
              "simulation and training",
              "standardization and craft",
              "succession",
              "supply and standards",
              "transport and machinery",
              "transport and structural review",
              "uncertainty and public safety",
              "warning partnership",
              "water quality partnership"

              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "cargo_from_origin": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "from_poi_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^poi-[a-z0-9-]+$"
          },
          "from_region_id": {
            "type": "string",
            "minLength": 1,

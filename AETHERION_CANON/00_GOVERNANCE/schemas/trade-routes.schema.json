{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canon_status",
    "records",
    "route_count_note",
    "schema_version",
    "source_ids"
  ],
  "properties": {
    "canon_status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "LOCKED",
        "RECOVERED",
        "PROPOSED",
        "UNRESOLVED",
        "DEPRECATED"
      ]
    },
    "records": {
      "type": "array",

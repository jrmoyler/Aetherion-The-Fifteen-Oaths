          "canon_status",
          "cargo_from_destination",
          "cargo_from_origin",
          "from_poi_id",
          "from_region_id",
          "id",
          "interruption",
          "modes",
          "name",
          "optional_modes",
          "ownership",
          "source_ids",
          "status",
          "terrain_transition",
          "to_poi_id",
          "to_region_id"
        ],
        "properties": {
          "alternate_region_path": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "region-01",
                "region-02",
                "region-03",
                "region-04",
                "region-05",
                "region-06",
                "region-07",
                "region-08",
                "region-09",
                "region-10",
                "region-11",
                "region-12",
                "region-13",
                "region-14",
                "region-15"
              ]
            },
            "uniqueItems": true
          },
          "canon_status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "LOCKED",
              "RECOVERED",
              "PROPOSED",
              "UNRESOLVED",
              "DEPRECATED"
            ]
          },
          "cargo_from_destination": {
            "type": "array",

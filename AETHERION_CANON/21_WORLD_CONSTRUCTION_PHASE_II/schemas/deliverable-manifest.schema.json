{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canon_status",
    "records",
    "registry_kind",
    "source_ids"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "canon_status": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "status",
          "canon_status",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "REQUIRES_FINAL_VALIDATION",
              "DOCUMENTED_PROPOSED"
            ]
          },
          "canon_status": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "registry_kind": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
